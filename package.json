{
  "name": "portfolio",
  "version": "2.0.0",
  "private": true,
  "description": "Joel G. Stadelman — portfolio (TypeScript + Tailwind CSS v4)",
  "scripts": {
    "build:css": "tailwindcss -i src/input.css -o dist/styles.css --minify",
    "build:js": "tsc",
    "build": "npm run build:css && npm run build:js",
    "watch": "concurrently \"tailwindcss -i src/input.css -o dist/styles.css --watch\" \"tsc --watch\""
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
