{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": false,
    "outDir": "dist",
    "sourceMap": false,
    "removeComments": false,
    "skipLibCheck": true
  },
  "include": ["src/app.ts"]
}
